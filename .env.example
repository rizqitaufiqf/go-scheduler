# .env.example
# Copy this file to .env and modify the values for your environment.

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=scheduler_db
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

# --- Redis Configuration ---
REDIS_ADDR=redis:6379

# --- Application Timezone ---
TZ=Asia/Jakarta

# --- Worker Configuration ---
# Maximum number of tasks the worker can process concurrently.
WORKER_CONCURRENCY=10
# How often (in seconds) the worker polls Redis for due tasks.
WORKER_POLL_INTERVAL_SECONDS=10

# --- Task Resilience & Locking Configuration ---
# Duration (in seconds) a distributed lock is held for a task.
# This should be long enough for most tasks to complete. The watchdog will refresh it for long-running tasks.
LOCK_TTL_SECONDS=300

# How often (in seconds) the periodic self-healing process runs to check for inconsistencies.
PERIODIC_RECON_INTERVAL_SECONDS=300

# --- Retry Backoff Configuration ---
# The base delay (in seconds) for the first retry attempt.
BACKOFF_BASE_DELAY_SECONDS=5
# The maximum delay (in seconds) between any two retry attempts.
BACKOFF_MAX_DELAY_SECONDS=300