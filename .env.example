# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=scheduler_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Server Configuration
PORT=8080
TZ=Asia/Jakarta

# Asynq Worker Configuration
WORKER_CONCURRENCY=10

# Retry Configuration
MAX_RETRY=5
RETRY_DELAY_FUNC=exponential  # exponential, linear, or constant

# Task Configuration
TASK_TIMEOUT_SECONDS=300      # 5 minutes
TASK_RETENTION_HOURS=24       # Keep completed tasks for 24 hours